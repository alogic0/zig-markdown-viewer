{
  "manifest_version": 3,
  "name": "Zig Markdown Viewer",
  "short_name": "Zig MD",
  "version": "0.7.1",
  "description": "Fast, local-first Markdown and source rendering powered by Zig and WebAssembly.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "action": {
    "default_title": "Zig Markdown Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file://*/*.md",
        "file://*/*.markdown",
        "file://*/*.mkd",
        "file://*/*.mdx",
        "file://*/*.MD",
        "file://*/*.MARKDOWN",
        "file://*/*.MKD",
        "file://*/*.MDX",
        "http://*/*.md",
        "http://*/*.markdown",
        "http://*/*.mkd",
        "http://*/*.mdx",
        "https://*/*.md",
        "https://*/*.markdown",
        "https://*/*.mkd",
        "https://*/*.mdx",
        "http://*/*.MD",
        "http://*/*.MARKDOWN",
        "http://*/*.MKD",
        "http://*/*.MDX",
        "https://*/*.MD",
        "https://*/*.MARKDOWN",
        "https://*/*.MKD",
        "https://*/*.MDX",
        "http://*/*.md?*",
        "http://*/*.markdown?*",
        "http://*/*.mkd?*",
        "http://*/*.mdx?*",
        "https://*/*.md?*",
        "https://*/*.markdown?*",
        "https://*/*.mkd?*",
        "https://*/*.mdx?*",
        "http://*/*.MD?*",
        "http://*/*.MARKDOWN?*",
        "http://*/*.MKD?*",
        "http://*/*.MDX?*",
        "https://*/*.MD?*",
        "https://*/*.MARKDOWN?*",
        "https://*/*.MKD?*",
        "https://*/*.MDX?*",
        "file://*/*.md?*",
        "file://*/*.markdown?*",
        "file://*/*.mkd?*",
        "file://*/*.mdx?*",
        "file://*/*.MD?*",
        "file://*/*.MARKDOWN?*",
        "file://*/*.MKD?*",
        "file://*/*.MDX?*"
      ],
      "js": ["js/standalone.js", "js/wasm.js", "js/mathml-policy.js", "js/html-math-policy.js", "js/content.js"],
      "css": ["css/content.css", "css/math.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["source.html", "renderer.wasm", "icons/favicon.svg", "css/content.css", "css/math.css", "css/source.css", "css/fonts/ZigMathSTIX.woff2", "js/source-languages.js", "js/source.js", "js/wasm.js"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
